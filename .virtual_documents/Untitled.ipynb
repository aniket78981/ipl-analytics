    "Sawai Mansingh Stadium": "Sawai Mansingh Stadium, Jaipur",
    "Wankhede Stadium": "Wankhede Stadium, Mumbai",
    "Sheikh Zayed Stadium": "Sheikh Zayed Stadium, Abu Dhabi",
    "Zayed Cricket Stadium, Abu Dhabi": "Sheikh Zayed Stadium, Abu Dhabi",
}
matches["venue"] = matches["venue"].replace(venue_map)

# Missing city: venue se fill
matches.loc[matches["venue"] == "Dubai International Cricket Stadium", "city"] = matches["city"].fillna("Dubai")
matches.loc[matches["venue"] == "Sharjah Cricket Stadium", "city"] = matches["city"].fillna("Sharjah")
matches["city"] = matches["city"].fillna("Unknown")

print("Venues:", matches["venue"].nunique())   # ~36 aana chahiye
print("Unknown city:", (matches["city"] == "Unknown").sum())
print(sorted(matches["city"].unique()))


match_cols = ["id", "season", "date", "city", "venue", "match_type",
              "toss_winner", "toss_decision", "winner"]

df = deliveries.merge(matches[match_cols], left_on="match_id", right_on="id", how="left")
df = df.drop(columns="id")

print(df.shape)                     # (260920, 25)
print(df["season"].isnull().sum())  # 0

df.to_csv("data/ipl_clean.csv", index=False)
